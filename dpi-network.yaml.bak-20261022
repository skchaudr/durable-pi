# Sab's Durable Pi network. Mirrors pi-durable-lab/dpi/dpi-network.yaml (the committed copy).
# Tokens never live here; each device generates its own in <home_dir>/backend.env.
defaults:
  port: 4780
  node: 24
  code_dir: ~/dpi
  home_dir: ~/.dpi
  start_dirs: ["~/dpi-work", "~/repos"]
  env_keys: [OPENROUTER_API_KEY, CLIPROXY_API_KEY]

devices:
  local:
    name: sab-air
    kind: local
